# Task runner for {{ project_name }}. Run `just` to list recipes.
set shell := ["bash", "-cu"]

# uv-managed env + deps, git init, hooks
bootstrap:
    uv sync
    test -d .git || git init -q
    @echo "bootstrap done"

# run the front locally
dev:
    uv run {{ module_name }}

# unit + contract tests (hermetic; never touches live external systems)
# --cov-fail-under=90 gates the FULL suite here (not in [tool.pytest.ini_options] addopts):
# `just contracts` runs a SUBSET (tests/contract_tests alone exercises a thin slice of
# src/{{ module_name }}) whose per-subset coverage is inherently far below 90% — a global
# addopts gate would fail an otherwise-green subset run.
test:
    uv run pytest -q --cov=src/{{ module_name }} --cov-fail-under=90

# validate I/O schemas against the pinned platform contracts
contracts:
    uv run pytest -q tests/contract_tests

# lint + secret scan
lint:
    uv run ruff check .
    @command -v gitleaks >/dev/null && gitleaks detect --no-banner || echo "gitleaks not installed; skipping"

# gate local/CI: lint + full coverage-gated test suite + contracts
check: lint test contracts

# pull scaffold/base improvements into this repo
update:
    uvx copier update --trust

default:
    @just --list
